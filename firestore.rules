rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isContentEditor() {
      return isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
            && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'editor']);
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/content_meta/bootstrap_locked);
    }

    function nonNegInt(field) {
      return field is int && field >= 0 && field < 100000000;
    }

    // Firestore grava número como int OU float conforme o SDK. Regras tratam
    // 15 e 15.0 como o mesmo placar — senão o ranking inteiro toma PERMISSION_DENIED.
    function nonNegNum(field) {
      return (field is int || field is float)
        && field >= 0
        && field < 100000000;
    }

    function asFloat(field) {
      return field is int ? field * 1.0 : field;
    }

    function scoresEqual(left, right) {
      return nonNegNum(left) && nonNegNum(right) && asFloat(left) == asFloat(right);
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function userTotalSteps() {
      return userExists()
        ? (('steps' in userData() && nonNegNum(userData().steps))
            ? userData().steps
            : (('xp' in userData() && nonNegNum(userData().xp))
                ? userData().xp
                : 0))
        : 0;
    }

    function userWeeklySteps() {
      return userExists()
        ? (('weeklySteps' in userData() && nonNegNum(userData().weeklySteps))
            ? userData().weeklySteps
            : (('weeklyXp' in userData() && nonNegNum(userData().weeklyXp))
                ? userData().weeklyXp
                : 0))
        : 0;
    }

    function userMonthlySteps() {
      return userExists()
        ? (('monthlySteps' in userData() && nonNegNum(userData().monthlySteps))
            ? userData().monthlySteps
            : 0)
        : 0;
    }

    // Ranking só pode carregar o xp/steps já gravado em users/{uid}.
    // Fecha o atalho de inflar o placar direto na coleção da Caravana.
    // playerId tem de ser argumento: função no escopo externo não enxerga
    // o curinga {uid} do match. Ler `uid` aqui estoura "Null value error"
    // e o cliente só vê PERMISSION_DENIED em todo o ranking.
    function rankingScoreMatches(expected, playerId) {
      return isSignedIn()
        && request.auth.uid == playerId
        && nonNegNum(expected)
        && (!('xp' in request.resource.data)
            || scoresEqual(request.resource.data.xp, expected))
        && (!('steps' in request.resource.data)
            || scoresEqual(request.resource.data.steps, expected))
        && (('xp' in request.resource.data)
            || ('steps' in request.resource.data));
    }

    function ownRankingDelete(playerId) {
      return isSignedIn() && request.auth.uid == playerId;
    }

    // [owner] bloqueou quem faz o pedido — convite, desafio, reconhecimento
    // e chamado dele são recusados.
    function blockedBy(owner) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocks/$(request.auth.uid));
    }

    function isYmd(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isYearMonth(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // Progresso: qualquer autenticado lê (ranking geral precisa de nome/passos
    // dos outros). Escrita só do dono.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (!('steps' in request.resource.data) || nonNegInt(request.resource.data.steps))
        && (!('xp' in request.resource.data) || nonNegInt(request.resource.data.xp))
        && (!('weeklySteps' in request.resource.data) || nonNegInt(request.resource.data.weeklySteps))
        && (!('weeklyXp' in request.resource.data) || nonNegInt(request.resource.data.weeklyXp))
        && (!('monthlySteps' in request.resource.data) || nonNegInt(request.resource.data.monthlySteps))
        && (!('streak' in request.resource.data) || nonNegInt(request.resource.data.streak))
        && (!('bestStreak' in request.resource.data) || nonNegInt(request.resource.data.bestStreak))
        && (!('steps' in request.resource.data) || !('xp' in request.resource.data)
            || request.resource.data.steps == request.resource.data.xp)
        && (!('weeklySteps' in request.resource.data) || !('weeklyXp' in request.resource.data)
            || request.resource.data.weeklySteps == request.resource.data.weeklyXp)
        // Resultado da Caravana é do servidor (Cloud Function settleLeagueWeek).
        && (resource == null
            ? !('leagueResult' in request.resource.data)
            : request.resource.data.get('leagueResult', null)
                == resource.data.get('leagueResult', null))
        // Selo e estado do Peregrino+ são do servidor (webhook RevenueCat
        // em functions/revenuecat.js). O cliente lê, nunca grava: sem
        // isto, qualquer um se dava o selo mexendo no próprio doc.
        && (resource == null
            ? !('supporter' in request.resource.data)
                || request.resource.data.supporter == false
            : request.resource.data.get('supporter', false)
                == resource.data.get('supporter', false))
        && (resource == null
            ? !('plusActive' in request.resource.data)
                || request.resource.data.plusActive == false
            : request.resource.data.get('plusActive', false)
                == resource.data.get('plusActive', false))
        && (resource == null
            ? !('plusProductId' in request.resource.data)
            : request.resource.data.get('plusProductId', null)
                == resource.data.get('plusProductId', null))
        && (resource == null
            ? !('plusExpiresAt' in request.resource.data)
            : request.resource.data.get('plusExpiresAt', null)
                == resource.data.get('plusExpiresAt', null))
        && (resource == null
            ? !('plusWillRenew' in request.resource.data)
            : request.resource.data.get('plusWillRenew', null)
                == resource.data.get('plusWillRenew', null))
        // Teste grátis: só o webhook marca. Sem isto, o cliente fingia
        // não estar em trial e liberava passe de trilha.
        && (resource == null
            ? !('plusInTrial' in request.resource.data)
                || request.resource.data.plusInTrial == false
            : request.resource.data.get('plusInTrial', false)
                == resource.data.get('plusInTrial', false))
        // Vaga do Pioneiro: só o webhook marca. O cliente não se conta.
        && (resource == null
            ? !('pioneerCounted' in request.resource.data)
            : request.resource.data.get('pioneerCounted', false)
                == resource.data.get('pioneerCounted', false))
        // Desbravador (testou antes do lançamento): só o script do admin
        // marca (admin/scripts/mark_desbravadores.mjs).
        && (resource == null
            ? !('desbravador' in request.resource.data)
            : request.resource.data.get('desbravador', false)
                == resource.data.get('desbravador', false))
        // Líder do piloto de grupos: só o script do admin marca
        // (admin/scripts/mark_group_pilots.mjs).
        && (resource == null
            ? !('groupsPilot' in request.resource.data)
            : request.resource.data.get('groupsPilot', false)
                == resource.data.get('groupsPilot', false))
        // giftedTrails no público: nunca. Mora no private (legado) ou em
        // users/{uid}/giftedTrails/{slug}. Mapa vazio passa: a 1.0.40
        // manda `giftedTrails: {}` em todo save.
        && (resource == null
            ? !('giftedTrails' in request.resource.data)
              || request.resource.data.giftedTrails == {}
            : !('giftedTrails' in request.resource.data)
              || request.resource.data.giftedTrails
                  == resource.data.get('giftedTrails', {}));
    }

    // Contagem do Pioneiro (primeiras compras de plus_founder_annual).
    // O webhook soma; o paywall só lê.
    match /stats/pioneer {
      allow read: if true;
      allow write: if false;
    }

    // Liga semanal: qualquer autenticado lê; o dono só grava o próprio
    // placar se ele espelhar users/{uid}.weeklySteps da semana corrente.
    match /leagues/{week}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    match /leagues/{week}/tiers/{tier}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && tier.matches('^[0-4]$')
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    // Salas da semana: só a Cloud Function onLeaguePlayerCreate escreve.
    match /leagues/{week}/tiers/{tier}/cohorts/{cohort} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Grupo fechado da caravana (célula/paróquia) — mesmo critério da liga semanal.
    match /leagueGroups/{code}/weeks/{week}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    match /overallPlayers/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if rankingScoreMatches(userTotalSteps(), uid);
    }

    match /monthlyLeagues/{month}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      // weekXp (passos da semana na mesma linha) também vem de users/{uid}.
      allow create, update: if isYearMonth(month)
        && rankingScoreMatches(userMonthlySteps(), uid)
        && (!('weekXp' in request.resource.data)
            || scoresEqual(request.resource.data.weekXp, userWeeklySteps()))
        && (!userExists()
            || !('monthlyMonth' in userData())
            || userData().monthlyMonth == null
            || userData().monthlyMonth == month);
    }

    // Caminhada coletiva da temporada: cada peregrino escreve só a própria
    // linha; todos leem para contar quem está junto.
    match /seasonWalks/{campaign}/walkers/{uid} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'portraitStyle', 'days', 'lastDay', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.days is int
        && request.resource.data.days >= 0
        && request.resource.data.days <= 40
        && (request.resource.data.lastDay == null
            || isYmd(request.resource.data.lastDay));
    }

    // Prêmio do Advento (functions/advent.js). A cena do dia: o app cria
    // "start" ao abrir e marca "done" ao terminar; o servidor confere os
    // horários do próprio Firestore e grava a prova. Sem conta anônima.
    match /seasonWalks/{campaign}/scenes/{id} {
      function notAnonymous() {
        return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow get: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if notAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'day', 'state', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is int
        && request.resource.data.day >= 1
        && request.resource.data.day <= 40
        && id == request.auth.uid + '_' + string(request.resource.data.day)
        && request.resource.data.state == 'start'
        && request.resource.data.at == request.time;
      allow update: if notAnonymous()
        && resource.data.uid == request.auth.uid
        && resource.data.state == 'start'
        && request.resource.data.state == 'done'
        && request.resource.data.doneAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state', 'doneAt']);
      // Cena aberta e largada pode recomeçar; a terminada fica.
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.state == 'start';
    }

    // Prova, prêmio e foto do dia 1: só o servidor grava; o dono lê.
    match /seasonWalks/{campaign}/proof/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /seasonWalks/{campaign}/rewards/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /seasonWalks/{campaign}/roster/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Configuração pública das campanhas (prazo, meses). Só o console grava.
    match /campaigns/{id} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Salas de estudo privadas.
    match /rooms/{code} {
      function isRoomMember(uid) {
        return exists(/databases/$(database)/documents/rooms/$(code)/members/$(uid));
      }

      // Grupo de verdade só com 3 pessoas: propósito, estudo e leitura só
      // começam ou mudam com `memberCount` >= 3 (a function conta; sala
      // antiga sem contagem passa até o backfill). Tirar sempre pode.
      function formedOrSame(k) {
        return request.resource.data.get(k, null) == resource.data.get(k, null)
          || request.resource.data.get(k, null) == null
          || resource.data.get('memberCount', 99) >= 3;
      }

      allow read: if isSignedIn();
      // Grupo do piloto (`pilot`) só nasce de quem o admin marcou como
      // líder do piloto (users/{uid}.groupsPilot).
      allow create: if isSignedIn()
        && !('memberCount' in request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.get('pilot', false) == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupsPilot', false) == true);
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      // Só o líder edita. Passar a liderança exige que o novo líder já esteja
      // na lista do grupo. `pilot` não muda depois de criado.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.get('pilot', false)
            == resource.data.get('pilot', false)
        && (request.resource.data.ownerId == resource.data.ownerId
            || isRoomMember(request.resource.data.ownerId))
        && request.resource.data.get('memberCount', -1)
            == resource.data.get('memberCount', -1)
        && formedOrSame('plan')
        && formedOrSame('study')
        && formedOrSame('reading')
        // O líder decide se os membros leem as respostas uns dos outros.
        && request.resource.data.get('answersPrivate', false) is bool
        // Propósito do grupo: um mapa com até 60 dias.
        && (!('plan' in request.resource.data)
            || (request.resource.data.plan is map
                && request.resource.data.plan.days is list
                && request.resource.data.plan.days.size() <= 60));

      // Fechamento da semana (revelação): só o líder grava; quem é do
      // grupo lê. Um doc por semana (id = segunda-feira).
      match /closings/{week} {
        allow read: if isSignedIn() && isRoomMember(request.auth.uid);
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/rooms/$(code)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(code)).data.get('memberCount', 99) >= 3
          && isYmd(week)
          && request.resource.data.week == week
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.groupPct is int
          && request.resource.data.groupPct >= 0
          && request.resource.data.groupPct <= 100
          && request.resource.data.faithful is list
          && request.resource.data.faithful.size() <= 50
          && request.resource.data.constant is list
          && request.resource.data.constant.size() <= 50
          && request.resource.data.get('grown', []) is list
          && request.resource.data.get('grown', []).size() <= 50;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/rooms/$(code)).data.ownerId == request.auth.uid;
      }

      // Resposta à pergunta do dia do propósito (dayKey = "planId_dia").
      // Só quem é do grupo lê; cada um grava a própria; o líder apaga
      // qualquer uma.
      // Membro lê as respostas do dia só depois de responder, e só se o
      // líder não as fechou (`answersPrivate`); o líder lê sempre (modera).
      match /answers/{dayKey}/by/{uid} {
        allow read: if isSignedIn() && isRoomMember(request.auth.uid)
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/rooms/$(code)).data.ownerId == request.auth.uid
              || (get(/databases/$(database)/documents/rooms/$(code)).data.get('answersPrivate', false) != true
                  && exists(/databases/$(database)/documents/rooms/$(code)/answers/$(dayKey)/by/$(request.auth.uid))));
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && isRoomMember(uid)
          && request.resource.data.uid == uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 280
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80;
        allow delete: if isSignedIn()
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/rooms/$(code)).data.ownerId == request.auth.uid);
      }

      // Chamado para estudar: um doc por destinatário, no máximo 1 por dia.
      match /nudges/{toUid} {
        allow read: if isSignedIn() && isRoomMember(request.auth.uid);
        allow create, update: if isSignedIn()
          && toUid != request.auth.uid
          && !blockedBy(toUid)
          && isRoomMember(request.auth.uid)
          && isRoomMember(toUid)
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.day is string
          && isYmd(request.resource.data.day)
          && (resource == null || resource.data.day != request.resource.data.day);
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isSignedIn();
        allow delete: if ownRankingDelete(uid);
        // O placar da célula é o do próprio membro. Não espelha users/{uid}:
        // esse get() recusava a criação do grupo quando o weeklySteps local
        // ainda não era o número gravado no perfil (int vs float, ou 0 na nuvem).
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && (!('xp' in request.resource.data) || nonNegNum(request.resource.data.xp))
          && (!('steps' in request.resource.data) || nonNegNum(request.resource.data.steps))
          && (('xp' in request.resource.data) || ('steps' in request.resource.data))
          && (!('xp' in request.resource.data) || !('steps' in request.resource.data)
              || scoresEqual(request.resource.data.xp, request.resource.data.steps));
      }
    }

    // Companhias de caminhada (pares).
    match /companies/{code} {
      allow get: if isSignedIn() && (
        resource == null
        || resource.data.hostId == request.auth.uid
        || resource.data.guestId == request.auth.uid
        || resource.data.guestId == null
      );
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
        // Companhia encerrada não volta: ninguém mexe mais (só o host apaga).
        && !('endedAt' in resource.data)
        && (resource.data.hostId == request.auth.uid
            || resource.data.guestId == request.auth.uid
            || (resource.data.guestId == null
                && request.resource.data.guestId == request.auth.uid))
        && request.resource.data.hostId == resource.data.hostId
        // Sair encerra a dupla para os dois: só endedAt/endedBy, assinado
        // por quem sai.
        && (!('endedAt' in request.resource.data)
            || (request.resource.data.endedAt == request.time
                && request.resource.data.endedBy == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['endedAt', 'endedBy', 'updatedAt'])))
        // Hora em que o par entrou (foto do Advento): só a do servidor, e
        // não muda depois.
        && (request.resource.data.get('guestJoinedAt', null)
              == resource.data.get('guestJoinedAt', null)
            || (resource.data.get('guestJoinedAt', null) == null
                && request.resource.data.guestJoinedAt == request.time))
        // Aceno: texto curto (pronto ou escrito no Peregrino+). O push
        // passa pelo filtro na function onCompanionNudge.
        && (!('nudgeMessage' in request.resource.data)
            || (request.resource.data.nudgeMessage is string
                && request.resource.data.nudgeMessage.size() <= 140));
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    // Esquina da Caravana (desafio de uma cena, até domingo).
    match /corners/{id} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.resource.data.challengerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.opponentId is string
        && request.resource.data.opponentId != request.auth.uid
        && !blockedBy(request.resource.data.opponentId)
        && request.resource.data.status == 'pending'
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasAll([
             request.auth.uid,
             request.resource.data.opponentId
           ]);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.challengerId == resource.data.challengerId
        && request.resource.data.opponentId == resource.data.opponentId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.missionSlug == resource.data.missionSlug
        && request.resource.data.trailSlug == resource.data.trailSlug
        && request.resource.data.weekStart == resource.data.weekStart;
      allow delete: if false;
    }

    // Convite de grupo dentro do app. Quem recebe aceita em Grupos.
    match /roomInvites/{id} {
      function isMemberOfInvitedRoom(code) {
        return exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
      }

      function roomInviteIdentitySame() {
        return request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.roomName == resource.data.roomName
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.fromName == resource.data.fromName
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.toName == resource.data.toName
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function roomInviteShape(data) {
        return data.keys().hasAll([
            'roomCode', 'roomName', 'kind', 'fromUid', 'fromName',
            'toUid', 'toName', 'participantIds', 'status', 'createdAt'
          ])
          && data.roomCode is string
          && data.roomCode.size() >= 4
          && data.roomCode.size() <= 8
          && data.roomName is string
          && data.roomName.size() > 0
          && data.roomName.size() <= 40
          && data.fromUid == request.auth.uid
          && data.toUid is string
          && data.toUid.size() > 0
          && data.toUid.size() <= 128
          && data.toUid != request.auth.uid
          && data.fromName is string
          && data.fromName.size() > 0
          && data.fromName.size() <= 120
          && data.toName is string
          && data.toName.size() > 0
          && data.toName.size() <= 120
          && data.kind in ['celula', 'discipulado', 'ebd', 'familia', 'amigos']
          && data.participantIds is list
          && data.participantIds.size() == 2
          && data.participantIds.hasAll([request.auth.uid, data.toUid])
          && data.createdAt is timestamp
          && id == data.roomCode + '_' + data.toUid
          // `pilot` só se o grupo é do piloto.
          && (data.get('pilot', false) == false
              || get(/databases/$(database)/documents/rooms/$(data.roomCode)).data.get('pilot', false) == true);
      }

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      // Quem já está no grupo pode chamar. O nome do grupo no doc é só
      // exibição — a prova de pertencimento é o doc em members/.
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && roomInviteShape(request.resource.data)
        && !blockedBy(request.resource.data.toUid)
        && isMemberOfInvitedRoom(request.resource.data.roomCode)
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode));
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && id == resource.data.roomCode + '_' + resource.data.toUid
        && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && roomInviteIdentitySame())
          || (request.auth.uid == resource.data.fromUid
            && isMemberOfInvitedRoom(resource.data.roomCode)
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.roomCode == resource.data.roomCode
            && request.resource.data.participantIds == resource.data.participantIds
            && request.resource.data.status in ['pending', 'cancelled']
            && roomInviteShape(request.resource.data))
        );
      allow delete: if false;
    }

    // Convite de companhia pelo nome (chamar alguém da Caravana). Um doc
    // por código: a companhia tem uma vaga, chamar outra pessoa troca o
    // destinatário. Quem recebe aceita entrando pelo código (regra de
    // companies) e marca aqui.
    match /companionInvites/{code} {
      function openCompanyOfMine(c) {
        let company = get(/databases/$(database)/documents/companies/$(c));
        return company.data.hostId == request.auth.uid
          && company.data.get('guestId', null) == null;
      }

      function companionInviteShape(data) {
        return data.keys().hasOnly([
            'code', 'fromUid', 'fromName', 'fromPhotoUrl', 'toUid', 'toName',
            'participantIds', 'status', 'createdAt'
          ])
          && data.keys().hasAll([
            'code', 'fromUid', 'fromName', 'toUid', 'toName',
            'participantIds', 'status', 'createdAt'
          ])
          && data.code == code
          && data.fromUid == request.auth.uid
          && data.toUid is string
          && data.toUid.size() > 0
          && data.toUid.size() <= 128
          && data.toUid != request.auth.uid
          && data.fromName is string
          && data.fromName.size() > 0
          && data.fromName.size() <= 120
          && data.toName is string
          && data.toName.size() > 0
          && data.toName.size() <= 120
          && data.participantIds is list
          && data.participantIds.size() == 2
          && data.participantIds.hasAll([request.auth.uid, data.toUid])
          && data.createdAt is timestamp;
      }

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      // Dono do convite aberto (sem ninguém dentro) chama ou troca quem
      // chamou; quem bloqueou não pode ser chamado.
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && companionInviteShape(request.resource.data)
        && !blockedBy(request.resource.data.toUid)
        && openCompanyOfMine(code);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && (
          // Quem recebeu: aceita ou recusa, sem mexer no resto.
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status']))
          // Quem chamou: chama de novo (outra pessoa ou a mesma) ou desfaz.
          || (request.auth.uid == resource.data.fromUid
            && ((request.resource.data.status == 'pending'
                  && companionInviteShape(request.resource.data)
                  && !blockedBy(request.resource.data.toUid)
                  && openCompanyOfMine(code))
                || (request.resource.data.status == 'cancelled'
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status']))))
        );
      allow delete: if false;
    }

    // Bloqueios: só o dono vê e mexe na própria lista.
    // Dados pessoais (e-mail, token, reflexões, erros, códigos de sala e
    // companhia, configurações): só o dono lê e grava. Functions usam o
    // Admin SDK e não passam por aqui.
    // giftedTrails no private é legado (só leitura): o cliente não muda —
    // senão qualquer um se dava todas as trilhas Plus. O mapa vivo mora
    // em users/{uid}/giftedTrails/{slug}, criado só no resgate.
    function privateGiftedTrailsOk() {
      return resource == null
        ? !('giftedTrails' in request.resource.data)
          || request.resource.data.giftedTrails == {}
        : !('giftedTrails' in request.resource.data)
          || request.resource.data.giftedTrails
              == resource.data.get('giftedTrails', {});
    }

    match /users/{uid}/private/{doc} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && privateGiftedTrailsOk();
    }

    // Passe de trilha (Peregrino+): quem assina libera 1 trilha por mês
    // para outra pessoa. O id é o código do link. O marco do mês em
    // users/{uid}/giftMonths/{mês UTC} nasce junto com o passe (batch) e
    // não muda: segura o segundo passe no mesmo mês. Um resgate por passe.
    // Passe aberto (trailSlug vazio) vai no convite de companhia: quem
    // resgata escolhe a trilha.
    function giftMonthNow() {
      return string(request.time.year()) + '-'
        + (request.time.month() < 10 ? '0' : '')
        + string(request.time.month());
    }

    function giftTrailSlugOk(slug) {
      return slug is string && slug.matches('^[a-z0-9-]{1,80}$');
    }

    // Trilha liberada por passe: nasce no mesmo batch/tx do resgate.
    // O cliente não inventa slug — o passe tem que estar (ou ficar)
    // resgatado por este uid com o mesmo trailSlug.
    match /users/{uid}/giftedTrails/{trailSlug} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && giftTrailSlugOk(trailSlug)
        && request.resource.data.keys().hasOnly([
          'fromName', 'code', 'redeemedAt'
        ])
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 40
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.redeemedAt == request.time
        && getAfter(/databases/$(database)/documents/trailGifts/$(request.resource.data.code)).data.toUid == uid
        && getAfter(/databases/$(database)/documents/trailGifts/$(request.resource.data.code)).data.trailSlug == trailSlug;
      allow update, delete: if false;
    }

    match /trailGifts/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly([
          'fromUid', 'fromName', 'trailSlug', 'month', 'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 40
        && (request.resource.data.trailSlug == ''
            || giftTrailSlugOk(request.resource.data.trailSlug))
        && request.resource.data.month == giftMonthNow()
        && request.resource.data.createdAt == request.time
        // Plus vem do webhook no doc público; o cliente não grava isso.
        // Teste grátis não dá passe: plusInTrial (webhook) bloqueia.
        && userExists()
        && userData().get('plusActive', false) == true
        && userData().get('plusInTrial', false) != true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/giftMonths/$(giftMonthNow())).data.code == code;
      allow update: if isSignedIn()
        && !('toUid' in resource.data)
        && (
          // Quem deu troca a trilha enquanto ninguém recebeu.
          (request.auth.uid == resource.data.fromUid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['trailSlug'])
            && giftTrailSlugOk(request.resource.data.trailSlug))
          // Quem recebe resgata uma vez; no passe aberto, escolhe a trilha.
          || (request.auth.uid != resource.data.fromUid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['toUid', 'toName', 'redeemedAt', 'trailSlug'])
            && giftTrailSlugOk(request.resource.data.trailSlug)
            && (resource.data.trailSlug == ''
                || request.resource.data.trailSlug == resource.data.trailSlug)
            && request.resource.data.toUid == request.auth.uid
            && request.resource.data.toName is string
            && request.resource.data.toName.size() <= 40
            && request.resource.data.redeemedAt == request.time)
        );
      allow delete: if false;
    }

    match /users/{uid}/giftMonths/{month} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && month == giftMonthNow()
        && request.resource.data.keys().hasOnly(['code', 'createdAt'])
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/trailGifts/$(request.resource.data.code))
        && existsAfter(/databases/$(database)/documents/trailGifts/$(request.resource.data.code));
      allow update, delete: if false;
    }

    // Meses de Peregrino+ ganhos por convite que virou assinatura
    // (functions/referral.js). Só o servidor grava; o dono lê o saldo.
    match /referralRewards/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid}/blocks/{blockedUid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && blockedUid != uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
    }

    // Moderação (functions/moderation.js): estado por conta e histórico.
    // Só o admin lê; só a Function grava.
    match /moderation/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /moderation_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Denúncias de outros peregrinos (usuários criam; editores revisam).
    match /user_reports/{id} {
      allow read, update, delete: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() <= 120
        && request.resource.data.status == 'open'
        && request.resource.data.reason in [
          'offensive_name', 'offensive_photo', 'harassment', 'spam', 'other'
        ]
        && request.resource.data.source in [
          'ranking', 'recognition', 'room_invite', 'room', 'corner', 'companion'
        ]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && (!('roomName' in request.resource.data)
            || (request.resource.data.roomName is string
                && request.resource.data.roomName.size() <= 40));
    }

    // Reconhecimento: um toque na cena ou na medalha de outro peregrino.
    // O destinatário lê a caixa; quem enviou só confirma o próprio doc.
    match /users/{uid}/recognitions/{recognitionId} {
      function recognitionCreateOk() {
        return request.resource.data.keys().hasOnly([
            'fromUid', 'fromName', 'toUid', 'kind', 'subjectKey', 'seen', 'createdAt'
          ])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.fromUid != uid
          && request.resource.data.kind in ['walk', 'medal']
          && request.resource.data.subjectKey is string
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() > 0
          && request.resource.data.fromName.size() <= 40
          && request.resource.data.seen == false
          && request.resource.data.createdAt is timestamp
          && recognitionId == request.resource.data.fromUid
              + '_' + request.resource.data.toUid
              + '_' + request.resource.data.kind
              + '_' + request.resource.data.subjectKey
          && (
            (request.resource.data.kind == 'walk'
              && isYmd(request.resource.data.subjectKey))
            || (request.resource.data.kind == 'medal'
              && request.resource.data.subjectKey.size() > 0
              && request.resource.data.subjectKey.size() <= 80
              && request.resource.data.subjectKey.matches('^[A-Za-z0-9:_-]+$'))
          );
      }

      allow get: if isSignedIn() && (
        resource == null
        || request.auth.uid == uid
        || resource.data.fromUid == request.auth.uid
      );
      allow list: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid != uid
        && !blockedBy(uid)
        && recognitionCreateOk();
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.seen == false
        && request.resource.data.seen == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // —— Conteúdo do currículo (trilhas / perguntas / estudos) ——
    match /content_trails/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    // Cards do Explorar criados no painel (admin/src/card-editor.js);
    // o app lê com o catálogo (ExploreCard em trail_catalog.dart).
    match /content_cards/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    // Linhas (portas) do Explorar criadas no painel (admin/src/shelf-editor.js).
    match /content_shelves/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_bank_questions/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_difficulties/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_mission_studies/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_meta/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    // Relatos de erro em perguntas (usuários autenticados criam; editores revisam).
    match /content_question_reports/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.category in [
          'theological', 'interpretation', 'wrong_answer',
          'feedback', 'typo', 'other'
        ]
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() < 200
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() < 600
        && request.resource.data.missionSlug is string
        && request.resource.data.missionSlug.size() < 120
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 800));
      allow update, delete: if isContentEditor();
    }

    // Relatos sobre o app — erro, conta, assinatura, sugestão (usuários
    // autenticados criam; editores revisam).
    match /app_reports/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.category in [
          'bug', 'account', 'subscription', 'suggestion', 'other'
        ]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() < 40
        && request.resource.data.platform is string
        && request.resource.data.platform.size() < 20
        && (!('osVersion' in request.resource.data)
            || (request.resource.data.osVersion is string
                && request.resource.data.osVersion.size() <= 120));
      allow update, delete: if isContentEditor();
    }

    // Indicações de autores (usuários autenticados criam; editores revisam).
    match /content_author_suggestions/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 15
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.instagram is string
        && request.resource.data.instagram.size() <= 30
        && (
          request.resource.data.phone.size() > 0
          || request.resource.data.email.size() > 0
          || request.resource.data.instagram.size() > 0
        );
      allow update, delete: if isContentEditor();
    }

    // Sugestões de novas trilhas (usuários autenticados criam; editores revisam).
    match /content_trail_suggestions/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 4
        && request.resource.data.text.size() <= 400
        && request.resource.data.realmId in [
          'antigo-testamento', 'novo-testamento',
          'vida-crista', 'teologia', 'outros'
        ];
      allow update, delete: if isContentEditor();
    }

    // Perfis do painel admin.
    // create: só enquanto bootstrap estiver aberto (1º admin). Depois: Console / admin.
    match /admin_users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && bootstrapOpen()
        && request.resource.data.role in ['admin', 'editor'];
      allow update, delete: if isAdmin();
    }
  }
}
