rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isContentEditor() {
      return isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
            && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'editor']);
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/content_meta/bootstrap_locked);
    }

    function nonNegInt(field) {
      return field is int && field >= 0 && field < 100000000;
    }

    // Firestore grava número como int OU float conforme o SDK. Regras tratam
    // 15 e 15.0 como o mesmo placar — senão o ranking inteiro toma PERMISSION_DENIED.
    function nonNegNum(field) {
      return (field is int || field is float)
        && field >= 0
        && field < 100000000;
    }

    function asFloat(field) {
      return field is int ? field * 1.0 : field;
    }

    function scoresEqual(left, right) {
      return nonNegNum(left) && nonNegNum(right) && asFloat(left) == asFloat(right);
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function userTotalSteps() {
      return userExists()
        ? (('steps' in userData() && nonNegNum(userData().steps))
            ? userData().steps
            : (('xp' in userData() && nonNegNum(userData().xp))
                ? userData().xp
                : 0))
        : 0;
    }

    function userWeeklySteps() {
      return userExists()
        ? (('weeklySteps' in userData() && nonNegNum(userData().weeklySteps))
            ? userData().weeklySteps
            : (('weeklyXp' in userData() && nonNegNum(userData().weeklyXp))
                ? userData().weeklyXp
                : 0))
        : 0;
    }

    function userMonthlySteps() {
      return userExists()
        ? (('monthlySteps' in userData() && nonNegNum(userData().monthlySteps))
            ? userData().monthlySteps
            : 0)
        : 0;
    }

    // Ranking só pode carregar o xp/steps já gravado em users/{uid}.
    // Fecha o atalho de inflar o placar direto na coleção da Caravana.
    // playerId tem de ser argumento: função no escopo externo não enxerga
    // o curinga {uid} do match. Ler `uid` aqui estoura "Null value error"
    // e o cliente só vê PERMISSION_DENIED em todo o ranking.
    function rankingScoreMatches(expected, playerId) {
      return isSignedIn()
        && request.auth.uid == playerId
        && nonNegNum(expected)
        && (!('xp' in request.resource.data)
            || scoresEqual(request.resource.data.xp, expected))
        && (!('steps' in request.resource.data)
            || scoresEqual(request.resource.data.steps, expected))
        && (('xp' in request.resource.data)
            || ('steps' in request.resource.data));
    }

    function ownRankingDelete(playerId) {
      return isSignedIn() && request.auth.uid == playerId;
    }

    function isYmd(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isYearMonth(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // Progresso: qualquer autenticado lê (ranking geral precisa de nome/passos
    // dos outros). Escrita só do dono.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (!('steps' in request.resource.data) || nonNegInt(request.resource.data.steps))
        && (!('xp' in request.resource.data) || nonNegInt(request.resource.data.xp))
        && (!('weeklySteps' in request.resource.data) || nonNegInt(request.resource.data.weeklySteps))
        && (!('weeklyXp' in request.resource.data) || nonNegInt(request.resource.data.weeklyXp))
        && (!('monthlySteps' in request.resource.data) || nonNegInt(request.resource.data.monthlySteps))
        && (!('streak' in request.resource.data) || nonNegInt(request.resource.data.streak))
        && (!('steps' in request.resource.data) || !('xp' in request.resource.data)
            || request.resource.data.steps == request.resource.data.xp)
        && (!('weeklySteps' in request.resource.data) || !('weeklyXp' in request.resource.data)
            || request.resource.data.weeklySteps == request.resource.data.weeklyXp)
        // Resultado da Caravana é do servidor (Cloud Function settleLeagueWeek).
        && (resource == null
            ? !('leagueResult' in request.resource.data)
            : request.resource.data.get('leagueResult', null)
                == resource.data.get('leagueResult', null));
    }

    // Liga semanal: qualquer autenticado lê; o dono só grava o próprio
    // placar se ele espelhar users/{uid}.weeklySteps da semana corrente.
    match /leagues/{week}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    match /leagues/{week}/tiers/{tier}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && tier.matches('^[0-4]$')
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    // Salas da semana: só a Cloud Function onLeaguePlayerCreate escreve.
    match /leagues/{week}/tiers/{tier}/cohorts/{cohort} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Grupo fechado da caravana (célula/paróquia) — mesmo critério da liga semanal.
    match /leagueGroups/{code}/weeks/{week}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYmd(week)
        && rankingScoreMatches(userWeeklySteps(), uid)
        && (!userExists()
            || !('weeklyWeek' in userData())
            || userData().weeklyWeek == null
            || userData().weeklyWeek == week);
    }

    match /overallPlayers/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if rankingScoreMatches(userTotalSteps(), uid);
    }

    match /monthlyLeagues/{month}/players/{uid} {
      allow read: if isSignedIn();
      allow delete: if ownRankingDelete(uid);
      allow create, update: if isYearMonth(month)
        && rankingScoreMatches(userMonthlySteps(), uid)
        && (!userExists()
            || !('monthlyMonth' in userData())
            || userData().monthlyMonth == null
            || userData().monthlyMonth == month);
    }

    // Salas de estudo privadas.
    match /rooms/{code} {
      function isRoomMember(uid) {
        return exists(/databases/$(database)/documents/rooms/$(code)/members/$(uid));
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      // Só o líder edita. Passar a liderança exige que o novo líder já esteja
      // na lista do grupo.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && (request.resource.data.ownerId == resource.data.ownerId
            || isRoomMember(request.resource.data.ownerId));

      // Chamado para estudar: um doc por destinatário, no máximo 1 por dia.
      match /nudges/{toUid} {
        allow read: if isSignedIn() && isRoomMember(request.auth.uid);
        allow create, update: if isSignedIn()
          && toUid != request.auth.uid
          && isRoomMember(request.auth.uid)
          && isRoomMember(toUid)
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.day is string
          && isYmd(request.resource.data.day)
          && (resource == null || resource.data.day != request.resource.data.day);
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isSignedIn();
        allow delete: if ownRankingDelete(uid);
        // O placar da célula é o do próprio membro. Não espelha users/{uid}:
        // esse get() recusava a criação do grupo quando o weeklySteps local
        // ainda não era o número gravado no perfil (int vs float, ou 0 na nuvem).
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && (!('xp' in request.resource.data) || nonNegNum(request.resource.data.xp))
          && (!('steps' in request.resource.data) || nonNegNum(request.resource.data.steps))
          && (('xp' in request.resource.data) || ('steps' in request.resource.data))
          && (!('xp' in request.resource.data) || !('steps' in request.resource.data)
              || scoresEqual(request.resource.data.xp, request.resource.data.steps));
      }
    }

    // Companhias de caminhada (pares).
    match /companies/{code} {
      allow get: if isSignedIn() && (
        resource == null
        || resource.data.hostId == request.auth.uid
        || resource.data.guestId == request.auth.uid
        || resource.data.guestId == null
      );
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.hostId == request.auth.uid
            || resource.data.guestId == request.auth.uid
            || (resource.data.guestId == null
                && request.resource.data.guestId == request.auth.uid))
        && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    // Esquina da Caravana (desafio de uma cena, até domingo).
    match /corners/{id} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.resource.data.challengerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.opponentId is string
        && request.resource.data.opponentId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasAll([
             request.auth.uid,
             request.resource.data.opponentId
           ]);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.challengerId == resource.data.challengerId
        && request.resource.data.opponentId == resource.data.opponentId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.missionSlug == resource.data.missionSlug
        && request.resource.data.trailSlug == resource.data.trailSlug
        && request.resource.data.weekStart == resource.data.weekStart;
      allow delete: if false;
    }

    // Convite de grupo dentro do app. Quem recebe aceita em Grupos.
    match /roomInvites/{id} {
      function isMemberOfInvitedRoom(code) {
        return exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
      }

      function roomInviteIdentitySame() {
        return request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.roomName == resource.data.roomName
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.fromName == resource.data.fromName
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.toName == resource.data.toName
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function roomInviteShape(data) {
        return data.keys().hasAll([
            'roomCode', 'roomName', 'kind', 'fromUid', 'fromName',
            'toUid', 'toName', 'participantIds', 'status', 'createdAt'
          ])
          && data.roomCode is string
          && data.roomCode.size() >= 4
          && data.roomCode.size() <= 8
          && data.roomName is string
          && data.roomName.size() > 0
          && data.roomName.size() <= 40
          && data.fromUid == request.auth.uid
          && data.toUid is string
          && data.toUid.size() > 0
          && data.toUid.size() <= 128
          && data.toUid != request.auth.uid
          && data.fromName is string
          && data.fromName.size() > 0
          && data.fromName.size() <= 120
          && data.toName is string
          && data.toName.size() > 0
          && data.toName.size() <= 120
          && data.kind in ['celula', 'discipulado', 'ebd', 'familia', 'amigos']
          && data.participantIds is list
          && data.participantIds.size() == 2
          && data.participantIds.hasAll([request.auth.uid, data.toUid])
          && data.createdAt is timestamp
          && id == data.roomCode + '_' + data.toUid;
      }

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      // Quem já está no grupo pode chamar. O nome do grupo no doc é só
      // exibição — a prova de pertencimento é o doc em members/.
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && roomInviteShape(request.resource.data)
        && isMemberOfInvitedRoom(request.resource.data.roomCode)
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode));
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && id == resource.data.roomCode + '_' + resource.data.toUid
        && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && roomInviteIdentitySame())
          || (request.auth.uid == resource.data.fromUid
            && isMemberOfInvitedRoom(resource.data.roomCode)
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.roomCode == resource.data.roomCode
            && request.resource.data.participantIds == resource.data.participantIds
            && request.resource.data.status in ['pending', 'cancelled']
            && roomInviteShape(request.resource.data))
        );
      allow delete: if false;
    }

    // Reconhecimento: um toque na cena ou na medalha de outro peregrino.
    // O destinatário lê a caixa; quem enviou só confirma o próprio doc.
    match /users/{uid}/recognitions/{recognitionId} {
      function recognitionCreateOk() {
        return request.resource.data.keys().hasOnly([
            'fromUid', 'fromName', 'toUid', 'kind', 'subjectKey', 'seen', 'createdAt'
          ])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.fromUid != uid
          && request.resource.data.kind in ['walk', 'medal']
          && request.resource.data.subjectKey is string
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() > 0
          && request.resource.data.fromName.size() <= 40
          && request.resource.data.seen == false
          && request.resource.data.createdAt is timestamp
          && recognitionId == request.resource.data.fromUid
              + '_' + request.resource.data.toUid
              + '_' + request.resource.data.kind
              + '_' + request.resource.data.subjectKey
          && (
            (request.resource.data.kind == 'walk'
              && isYmd(request.resource.data.subjectKey))
            || (request.resource.data.kind == 'medal'
              && request.resource.data.subjectKey.size() > 0
              && request.resource.data.subjectKey.size() <= 80
              && request.resource.data.subjectKey.matches('^[A-Za-z0-9:_-]+$'))
          );
      }

      allow get: if isSignedIn() && (
        resource == null
        || request.auth.uid == uid
        || resource.data.fromUid == request.auth.uid
      );
      allow list: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid != uid
        && recognitionCreateOk();
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.seen == false
        && request.resource.data.seen == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // —— Conteúdo do currículo (trilhas / perguntas / estudos) ——
    match /content_trails/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_bank_questions/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_difficulties/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_mission_studies/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }
    match /content_meta/{id} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    // Relatos de erro em perguntas (usuários autenticados criam; editores revisam).
    match /content_question_reports/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.category in [
          'theological', 'interpretation', 'wrong_answer',
          'feedback', 'typo', 'other'
        ]
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() < 200
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() < 600
        && request.resource.data.missionSlug is string
        && request.resource.data.missionSlug.size() < 120
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 800));
      allow update, delete: if isContentEditor();
    }

    // Indicações de autores (usuários autenticados criam; editores revisam).
    match /content_author_suggestions/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 15
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.instagram is string
        && request.resource.data.instagram.size() <= 30
        && (
          request.resource.data.phone.size() > 0
          || request.resource.data.email.size() > 0
          || request.resource.data.instagram.size() > 0
        );
      allow update, delete: if isContentEditor();
    }

    // Sugestões de novas trilhas (usuários autenticados criam; editores revisam).
    match /content_trail_suggestions/{id} {
      allow read: if isContentEditor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 4
        && request.resource.data.text.size() <= 400
        && request.resource.data.realmId in [
          'antigo-testamento', 'novo-testamento',
          'vida-crista', 'teologia', 'outros'
        ];
      allow update, delete: if isContentEditor();
    }

    // Perfis do painel admin.
    // create: só enquanto bootstrap estiver aberto (1º admin). Depois: Console / admin.
    match /admin_users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && bootstrapOpen()
        && request.resource.data.role in ['admin', 'editor'];
      allow update, delete: if isAdmin();
    }
  }
}
