# OS / IDE
.DS_Store
.idea/
.vscode/
*.pem

# Cursor / agent skill installs (local tooling, not app code)
.agents/
skills-lock.json

# Env
.env
.env.*
!.env.example

# Android release signing (nunca commitar)
**/android/key.properties
**/*.keystore
**/*.jks

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dart / Flutter (raiz; o app também tem o próprio .gitignore)
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Node (painel em admin/)
node_modules/
admin/dist/

# Misc
*.tsbuildinfo
.vercel/

# Firebase CLI local cache
.firebase/

# UIDs dos testadores marcados como Desbravadores (dado pessoal, fica local)
admin/exports/desbravadores.json

# Snapshots locais do publish V3 (regeneráveis; não versionar)
admin/**/backup/
admin/v3/_publish_log.txt

# Staging de arte das cenas (instalada em trilha_app/assets/art/)
admin/arte/cenas/provisorio/
