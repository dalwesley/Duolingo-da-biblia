  "morphExplainAbsolute": "Absoluto = forma libre del nombre, sin un “de…” pegado.",
  "morphExplainAdjective": "Adjetivo = califica el nombre (“bueno”, “grande”, “santo”).",
  "morphExplainAdverb": "Adverbio = modifica la acción (“aún”, “mucho”, “allí”).",
  "morphExplainAorist": "Aoristo = acción vista como un punto (sin duración).",
  "morphExplainArticle": "Artículo = marca lo determinado (“el”, “la”) en hebreo.",
  "morphExplainCohortative": "Cohortativo = “vamos…” / deseo en 1ª persona (“hagamos”).",
  "morphExplainConjunction": "Conjunción = une frases o palabras (“y”, “pero”, “que”).",
  "morphExplainConstruct": "Constructo = “de…” — une dos nombres (casa de David).",
  "morphExplainDetermined": "Determinado = forma marcada como definida (“el/la”).",
  "morphExplainDivineName": "Nombre divino = referencia a Dios en el original.",
  "morphExplainDual": "Dual = exactamente dos (ojos, manos, o un par).",
  "morphExplainFem": "Femenino = género gramatical en el original (no es “hembra” en español).",
  "morphExplainFuture": "Futuro = acción aún por venir.",
  "morphExplainHifil": "Hifil = causativo (“hacer que alguien haga”, “hacer acontecer”).",
  "morphExplainHitpael": "Hitpael = reflexivo o recíproco (“hacerse a sí”, “unos a otros”).",
  "morphExplainHofal": "Hofal = pasiva del hifil (“fue causado a”).",
  "morphExplainImperative": "Imperativo = orden o pedido directo.",
  "morphExplainImperfectGk": "Imperfecto griego = acción continua o repetida en el pasado.",
  "morphExplainImperfectHeb": "Imperfecto = acción en curso, habitual o futura.",
  "morphExplainInfAbsolute": "Infinitivo absoluto = énfasis (“ciertamente hará”, “hacer de hecho”).",
  "morphExplainInfConstruct": "Infinitivo constructo = forma verbal que se une a otra palabra (“al hacer”).",
  "morphExplainJussive": "Yusivo = deseo u orden suave en 3ª persona (“que él…”).",
  "morphExplainMasc": "Masculino = género gramatical en el original (no es “macho” en español).",
  "morphExplainNeuter": "Neutro = género gramatical sin masculino ni femenino (común en griego).",
  "morphExplainNifal": "Nifal = voz pasiva o reflexiva (“fue hecho”, “se hizo”).",
  "morphExplainNoun": "Sustantivo = nombra persona, lugar, cosa o idea.",
  "morphExplainObjectMarker": "Marcador de objeto = señala el complemento directo en hebreo (casi no se traduce).",
  "morphExplainParticiple": "Participio = acción como cualidad o estado continuo (“el que hace”).",
  "morphExplainParticle": "Partícula = palabra pequeña que amarra el sentido (no es el núcleo del versículo).",
  "morphExplainPerfect": "Perfecto = acción vista como completa (a menudo en el pasado).",
  "morphExplainPerson1": "1.ª persona = yo / nosotros — quien habla.",
  "morphExplainPerson2": "2.ª persona = tú / vosotros — a quien se habla.",
  "morphExplainPerson3": "3.ª persona = él / ella / ellos — de quien se habla.",
  "morphExplainPiel": "Piel = acción intensa o causativa (“hacer de verdad”, “intensificar”).",
  "morphExplainPl": "Plural = más de uno. En algunos nombres (como Elohim), puede marcar majestad, no cantidad.",
  "morphExplainPrep": "Preposición = une el sentido (“en”, “para”, “con”, “sobre”).",
  "morphExplainPresent": "Presente = acción ahora o habitual.",
  "morphExplainPronominal": "Pronominal = el sufijo funciona como pronombre (“mi”, “nuestro”, “de ellos”).",
  "morphExplainProper": "Propio = nombre de persona, lugar o título específico.",
  "morphExplainPual": "Pual = pasiva del piel (“fue hecho con intensidad”).",
  "morphExplainQal": "Qal = acción simple, el sentido básico del verbo.",
  "morphExplainSing": "Singular = uno solo — una persona, cosa o acción.",
  "morphExplainSuffix": "Sufijo = terminación pegada a la palabra (a menudo “mi”, “tu”, “su”).",
  "morphExplainVerb": "Verbo = la acción o el estado en el versículo.",
  "morphExplainWayyiqtol": "Wayyiqtol = narrativa secuencial (“y entonces…”), típica de las historias.",
  "morphExplainWeqatal": "Weqatal = secuencia en perfecto — continúa la línea narrativa o instructiva.",
