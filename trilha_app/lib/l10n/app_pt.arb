  "morphExplainAbsolute": "Absoluto = forma livre do nome, sem “de…” colado.",
  "morphExplainAdjective": "Adjetivo = qualifica o nome (“bom”, “grande”, “santo”).",
  "morphExplainAdverb": "Advérbio = modifica a ação (“ainda”, “muito”, “ali”).",
  "morphExplainAorist": "Aoristo = ação vista como um ponto (sem duração).",
  "morphExplainArticle": "Artigo = marca o determinado (“o”, “a”) no hebraico.",
  "morphExplainCohortative": "Coortativo = “vamos…” / desejo na 1ª pessoa (“façamos”).",
  "morphExplainConjunction": "Conjunção = une frases ou palavras (“e”, “mas”, “que”).",
  "morphExplainConstruct": "Construto = “de…” — liga dois nomes (casa de Davi).",
  "morphExplainDetermined": "Determinado = forma marcada como “o/a” (definida).",
  "morphExplainDivineName": "Nome divino = referência a Deus no original.",
  "morphExplainDual": "Dual = exatamente dois (olhos, mãos, ou um par).",
  "morphExplainFem": "Feminino = gênero gramatical no original (não é “fêmea” em português).",
  "morphExplainFuture": "Futuro = ação ainda por vir.",
  "morphExplainHifil": "Hifil = causativo (“fazer alguém fazer”, “fazer acontecer”).",
  "morphExplainHitpael": "Hitpael = reflexivo ou recíproco (“fazer a si mesmo”, “uns aos outros”).",
  "morphExplainHofal": "Hofal = passiva do hifil (“foi feito causar”).",
  "morphExplainImperative": "Imperativo = ordem ou pedido direto.",
  "morphExplainImperfectGk": "Imperfeito grego = ação contínua ou repetida no passado.",
  "morphExplainImperfectHeb": "Imperfecto = ação em curso, habitual ou futura.",
  "morphExplainInfAbsolute": "Infinitivo absoluto = ênfase (“certamente fará”, “fazer de fato”).",
  "morphExplainInfConstruct": "Infinitivo construto = forma verbal que se liga a outra palavra (“ao fazer”).",
  "morphExplainJussive": "Jussivo = desejo ou ordem suave na 3ª pessoa (“que ele…”).",
  "morphExplainMasc": "Masculino = gênero gramatical no original (não é “macho” em português).",
  "morphExplainNeuter": "Neutro = gênero gramatical sem masculino nem feminino (comum no grego).",
  "morphExplainNifal": "Nifal = voz passiva ou reflexiva (“foi feito”, “se fez”).",
  "morphExplainNoun": "Substantivo = nomeia pessoa, lugar, coisa ou ideia.",
  "morphExplainObjectMarker": "Marcador de objeto = aponta o complemento direto no hebraico (não se traduz).",
  "morphExplainParticiple": "Particípio = ação como qualidade ou estado contínuo (“o que faz”).",
  "morphExplainParticle": "Partícula = palavra pequena que amarra o sentido (não é o “miolo” do versículo).",
  "morphExplainPerfect": "Perfeito = ação vista como completa (muitas vezes no passado).",
  "morphExplainPerson1": "1ª pessoa = eu / nós — quem fala.",
  "morphExplainPerson2": "2ª pessoa = tu / vós — a quem se fala.",
  "morphExplainPerson3": "3ª pessoa = ele / ela / eles — de quem se fala.",
  "morphExplainPiel": "Piel = ação intensa ou causativa (“fazer de verdade”, “intensificar”).",
  "morphExplainPl": "Plural = mais de um. Em alguns nomes (como Elohim), pode marcar majestade, não quantidade.",
  "morphExplainPrep": "Preposição = liga o sentido (“em”, “para”, “com”, “sobre”).",
  "morphExplainPresent": "Presente = ação agora ou habitual.",
  "morphExplainPronominal": "Pronominal = o sufixo funciona como pronome (“meu”, “nosso”, “deles”).",
  "morphExplainProper": "Próprio = nome de pessoa, lugar ou título específico.",
  "morphExplainPual": "Pual = passiva do piel (“foi feito com intensidade”).",
  "morphExplainQal": "Qal = ação simples, no sentido básico do verbo.",
  "morphExplainSing": "Singular = um só — uma pessoa, coisa ou ação.",
  "morphExplainSuffix": "Sufixo = terminção colada na palavra (muitas vezes “meu”, “teu”, “dele”).",
  "morphExplainVerb": "Verbo = a ação ou o estado no versículo.",
  "morphExplainWayyiqtol": "Wayyiqtol = narrativa sequencial (“e então…”), típica das histórias.",
  "morphExplainWeqatal": "Weqatal = sequência no perfeito — continua a linha narrativa ou instrutiva.",
