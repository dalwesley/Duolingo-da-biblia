  "morphExplainAbsolute": "Absolute = free form of the noun, without a bound “of…”.",
  "morphExplainAdjective": "Adjective = qualifies the noun (“good”, “great”, “holy”).",
  "morphExplainAdverb": "Adverb = modifies the action (“still”, “very”, “there”).",
  "morphExplainAorist": "Aorist = action viewed as a point (without duration).",
  "morphExplainArticle": "Article = marks the definite (“the”) in Hebrew.",
  "morphExplainCohortative": "Cohortative = “let us…” / 1st-person wish (“let us make”).",
  "morphExplainConjunction": "Conjunction = joins clauses or words (“and”, “but”, “that”).",
  "morphExplainConstruct": "Construct = “of…” — links two nouns (house of David).",
  "morphExplainDetermined": "Determined = form marked as definite (“the”).",
  "morphExplainDivineName": "Divine name = a reference to God in the original.",
  "morphExplainDual": "Dual = exactly two (eyes, hands, or a pair).",
  "morphExplainFem": "Feminine = grammatical gender in the original (not “female” in English).",
  "morphExplainFuture": "Future = action yet to come.",
  "morphExplainHifil": "Hiphil = causative (“make someone do”, “cause to happen”).",
  "morphExplainHitpael": "Hithpael = reflexive or reciprocal (“do to oneself”, “to each other”).",
  "morphExplainHofal": "Hophal = passive of hiphil (“was caused to”).",
  "morphExplainImperative": "Imperative = direct command or request.",
  "morphExplainImperfectGk": "Greek imperfect = continuous or repeated past action.",
  "morphExplainImperfectHeb": "Imperfect = ongoing, habitual, or future action.",
  "morphExplainInfAbsolute": "Infinitive absolute = emphasis (“will surely do”, “indeed do”).",
  "morphExplainInfConstruct": "Infinitive construct = verbal form that binds to another word (“in doing”).",
  "morphExplainJussive": "Jussive = wish or soft command in the 3rd person (“let him…”).",
  "morphExplainMasc": "Masculine = grammatical gender in the original (not “male” in English).",
  "morphExplainNeuter": "Neuter = grammatical gender that is neither masculine nor feminine (common in Greek).",
  "morphExplainNifal": "Niphal = passive or reflexive voice (“was done”, “did itself”).",
  "morphExplainNoun": "Noun = names a person, place, thing, or idea.",
  "morphExplainObjectMarker": "Object marker = marks the direct object in Hebrew (often untranslated).",
  "morphExplainParticiple": "Participle = action as a quality or ongoing state (“the one who does”).",
  "morphExplainParticle": "Particle = small word that ties the sense together (not the core of the verse).",
  "morphExplainPerfect": "Perfect = action viewed as complete (often past).",
  "morphExplainPerson1": "1st person = I / we — the one speaking.",
  "morphExplainPerson2": "2nd person = you — the one spoken to.",
  "morphExplainPerson3": "3rd person = he / she / they — the one spoken about.",
  "morphExplainPiel": "Piel = intensive or causative action (“really do”, “intensify”).",
  "morphExplainPl": "Plural = more than one. In some names (like Elohim), it can mark majesty, not quantity.",
  "morphExplainPrep": "Preposition = links the sense (“in”, “to”, “with”, “upon”).",
  "morphExplainPresent": "Present = action now or habitual.",
  "morphExplainPronominal": "Pronominal = the suffix acts like a pronoun (“my”, “our”, “their”).",
  "morphExplainProper": "Proper = name of a specific person, place, or title.",
  "morphExplainPual": "Pual = passive of piel (“was done intensively”).",
  "morphExplainQal": "Qal = simple action, the basic sense of the verb.",
  "morphExplainSing": "Singular = just one — one person, thing, or action.",
  "morphExplainSuffix": "Suffix = ending attached to the word (often “my”, “your”, “his”).",
  "morphExplainVerb": "Verb = the action or state in the verse.",
  "morphExplainWayyiqtol": "Wayyiqtol = sequential narrative (“and then…”), typical of stories.",
  "morphExplainWeqatal": "Weqatal = perfect sequence — continues the narrative or instructional line.",
