<?xml version="1.0" encoding="utf-8"?>
<!-- Card da sequência: selo 🔥, chamada, contagem até a meia-noite e o Anan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_warm"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/widget_warm_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="🔥 12" />

            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Mantenha sua sequência" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Amanhã: O Criador" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            tools:text="12 dias seguidos · falta 1 cena" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_anan"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_anan_triste" />
</LinearLayout>
